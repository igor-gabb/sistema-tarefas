# Copie este arquivo para ".env" e preencha.
# NUNCA suba o .env para o GitHub: ele tem a senha do banco.

# Supabase -> Connect -> Direct -> Session pooler
DATABASE_URL=postgresql://postgres.xxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave que assina o cookie de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cole_aqui_a_chave_gerada
